{
  "name": "websign-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run test && npm run build",
    "seed": "npm run seed -w backend",
    "admin:create": "npm run admin:create -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
